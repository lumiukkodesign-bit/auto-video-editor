# Notion API トークン
# https://www.notion.so/my-integrations でインテグレーションを作成して取得
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# プロンプト集を作成する Notion ページの ID
# ページURLの末尾32文字（ハイフン区切り形式でも可）
# 例: https://www.notion.so/My-Page-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#     → NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
